{
  "expo": {
    "name": "Sepet",
    "slug": "camelapp",
    "version": "1.2.10",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.camelapp.app",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow SepetMD use geolocation for definig distance to restaurants and delivery price.",
        "NSLocationWhenInUseUsageDescription": "Allow SepetMD use geolocation for definig distance to restaurants and delivery price."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "versionCode": 13,
      "package": "com.camelapp.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDewxZSRZGrEek6CmiGGi2ps2CNlZIr8Qc"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-localization"
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) use geolocation for definig distance to restaurants and delivery price.",
          "locationAlwaysPermission": "Allow $(PRODUCT_NAME) use geolocation for definig distance to restaurants and delivery price.",
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) use geolocation for definig distance to restaurants and delivery price."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/AnonymousPro-Bold.ttf",
            "./assets/fonts/AnonymousPro-Regular.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#000000",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e149f77b-df25-4a08-a7e7-d885dc5397ab"
      }
    }
  }
}
