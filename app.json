{
  "expo": {
    "newArchEnabled": true,
    "name": "Sepet",
    "slug": "camelapp",
    "version": "1.2.50",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "sepetmd",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sepet.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Разрешить SepetMD использовать геолокацию для определения расстояния и цены доставки.",
        "NSLocationWhenInUseUsageDescription": "Разрешить SepetMD использовать геолокацию для определения расстояния и цены доставки.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:sepet.md"
      ],
      "buildNumber": "7"
    },
    "android": {
      "versionCode": 51,
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "package": "com.camelapp.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDewxZSRZGrEek6CmiGGi2ps2CNlZIr8Qc"
        }
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sepet.md",
              "pathPrefix": "/pub"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-localization"
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Разрешить $(PRODUCT_NAME) использовать геолокацию для определения расстояния и цены доставки.",
          "locationAlwaysPermission": "Разрешить $(PRODUCT_NAME) использовать геолокацию для определения расстояния и цены доставки.",
          "locationWhenInUsePermission": "Разрешить $(PRODUCT_NAME) использовать геолокацию для определения расстояния и цены доставки."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/AnonymousPro-Bold.ttf",
            "./assets/fonts/AnonymousPro-Regular.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#000000",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e149f77b-df25-4a08-a7e7-d885dc5397ab"
      }
    }
  }
}
