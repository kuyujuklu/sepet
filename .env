# Any non-empty value points the app at the local backend (src/constants/env/dev.js);
# empty means production (src/constants/env/prod.js). This file is NOT gitignored -
# blank it again before building a release.
EXPO_PUBLIC_IS_DEV=1

# Optional: force the host the app talks to. Leave unset and it reuses whatever
# host Metro is served from, which is what a phone on the same wifi needs.
# Android emulator:
# EXPO_PUBLIC_API_HOST=10.0.2.2
